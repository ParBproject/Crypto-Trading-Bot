# Exchange credentials. Use restricted testnet keys while developing.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET=

# Only required if exchange.sandbox is set to false.
BINANCE_API_KEY=
BINANCE_SECRET=

# Optional data and notification integrations.
COINGECKO_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Runtime controls.
LOG_LEVEL=INFO
# Live orders are refused unless this is exactly 1. Paper mode ignores it.
ALLOW_LIVE_TRADING=0
# Skips the per-order prompt only after live trading is armed.
CONFIRM_LIVE=0
